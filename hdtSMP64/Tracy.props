<?xml version="1.0" encoding="utf-8"?>
<!-- Tracy Profiler Property Sheet for hdtSMP64

     To enable Tracy profiling:
     1. In VS: View -> Property Manager
     2. Right-click your configuration -> Add Existing Property Sheet
     3. Select this file (Tracy.props)
     4. Rebuild

     Or via command line: msbuild /p:ForceImportBeforeCppTargets=Tracy.props
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <TracyDir>$(SolutionDir)external\tracy</TracyDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Add Tracy include directory -->
      <AdditionalIncludeDirectories>$(TracyDir)\public;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Enable Tracy (on-demand mode waits for profiler connection, disable ETW to avoid Windows SDK conflicts, NOMINMAX to fix min/max macro issues) -->
      <PreprocessorDefinitions>HDT_TRACY_ENABLE;TRACY_ENABLE;TRACY_ON_DEMAND;TRACY_NO_SYSTEM_TRACING;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- Tracy requires these Windows libraries -->
      <AdditionalDependencies>ws2_32.lib;dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- Include Tracy client source -->
  <ItemGroup>
    <ClCompile Include="$(TracyDir)\public\TracyClient.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <!-- Undefine CUDA to avoid conflict with Tracy's GpuContextType::CUDA enum -->
      <PreprocessorDefinitions>TRACY_ENABLE;TRACY_ON_DEMAND;TRACY_NO_SYSTEM_TRACING;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <UndefinePreprocessorDefinitions>CUDA;%(UndefinePreprocessorDefinitions)</UndefinePreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>
</Project>
