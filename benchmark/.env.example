# hdtSMP64 Benchmark Configuration
# Copy this file to .env and configure for your system

# ============================================================
# Mod Organizer 2 Configuration (RECOMMENDED for modded setups)
# ============================================================
# If you use MO2, configure these settings.
# The benchmark will launch SKSE through MO2's virtual filesystem.

# Path to ModOrganizer.exe
MO2_PATH=C:\Modding\MO2\ModOrganizer.exe

# Executable name as configured in MO2 (usually "SKSE" or "Skyrim Special Edition")
MO2_EXECUTABLE=SKSE

# MO2 profile name (optional - uses active profile if not specified)
# MO2_PROFILE=My Benchmark Profile

# ============================================================
# Direct Skyrim Launch (fallback if MO2 not configured)
# ============================================================
# Only used if MO2_PATH is not set or commented out.
# If not specified, will attempt auto-detection via Steam registry.

# SKYRIM_PATH=C:\Program Files (x86)\Steam\steamapps\common\Skyrim Special Edition\SkyrimSE.exe
